# Dominio público que apunta a este servidor (Caddy obtiene HTTPS automáticamente)
DOMAIN=mdm.tuempresa.com

# Administrador inicial (opcional; si no lo defines se genera una contraseña aleatoria)
ADMIN_USER=admin
# ADMIN_PASSWORD=

# Google Workspace (opcional, para cerrar sesiones de forma remota)
# GOOGLE_SA_KEY_FILE=/secrets/google-sa.json
# GOOGLE_ADMIN_EMAIL=admin@tuempresa.com
# GOOGLE_DOMAINS=tuempresa.com

# Marca institucional (opcional)
# BRAND_NAME=The Victoria School
# BRAND_PRODUCT=Gestión de equipos TI
# BRAND_PRIMARY=#0b2a55
# BRAND_ACCENT=#1d5fb8
