# Dominio público que apunta a este servidor (Caddy obtiene HTTPS automáticamente)
DOMAIN=mdm.tuempresa.com

# Administrador inicial (opcional; si no lo defines se genera una contraseña aleatoria)
ADMIN_USER=admin
# ADMIN_PASSWORD=

# Google Workspace (opcional, para cerrar sesiones de forma remota)
# GOOGLE_SA_KEY_FILE=/secrets/google-sa.json
# GOOGLE_ADMIN_EMAIL=admin@tuempresa.com
# GOOGLE_DOMAINS=tuempresa.com

# Roles: unidad organizativa que puede usar el rol "aprendiz" (solo registro de
# equipos y cierre de sesiones de Google de esa unidad).
# LEARNER_ORG_UNIT=Estudiantes Activos

# Correo saliente para enviar credenciales y avisos (opcional).
# Si no se configura SMTP, se intenta Gmail API con la cuenta de servicio
# (requiere el alcance https://www.googleapis.com/auth/gmail.send en la
# delegación de todo el dominio).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=no-responder@tvs.edu.co
# SMTP_PASS=contraseña-de-aplicación
# SMTP_FROM=FleetControl <no-responder@tvs.edu.co>

# Marca institucional (opcional)
# BRAND_NAME=The Victoria School
# BRAND_PRODUCT=Gestión de equipos TI
# BRAND_PRIMARY=#0b2a55
# BRAND_ACCENT=#1d5fb8
# BRAND_LOGO_URL=https://thevictoriaschool.edu.co/static/pix/logo-horizontal.a36e643498d0.png
# BRAND_SITE=https://thevictoriaschool.edu.co/

# Acceso remoto: túnel frp (WSS por el mismo dominio) + noVNC.
# Genera un token fuerte, por ejemplo: openssl rand -hex 24
# FRP_TOKEN=cambia-este-token
# FRP_PUBLIC_HOST=registro.tvs.edu.co
# FRP_PUBLIC_PORT=443
# FRP_REMOTE_PORT_START=41000
# FRP_REMOTE_PORT_END=41099
# FRPS_HOST=frps
# FRPS_PORT=7000
